			<key>IOUserClientClass</key>
			<string>PG106UserClient</string>
			<!-- GPL-2.0-only tree (pascal/kext/README.md). The match dictionary is a
			     deliberately wide net (HANDOFF-PASCAL.md Phase 3; same pattern as
			     kexts/NVRM/Info.plist): IOPCIPrimaryMatch compares the 32-bit
			     (device<<16 | vendor) word, and "value&mask" masks it first, so
			     0x000010de&0x0000ffff means vendor 0x10DE, any device.
			     IOPCIClassMatch is ANDed with it and pins the base class to 0x03
			     (display) with any subclass, so VGA (0x00) and 3D (0x02) functions
			     both match. The real gate is software: PG106::probe() accepts only
			     the GP106M/GP106BM mobile ids in src/pg106_device_gate.c
			     (0x1C20 0x1C21 0x1C22 0x1C23 0x1C60 0x1C61 0x1C62, pci.ids
			     2026.11.06), and start() additionally requires a GP106 BOOT_0.
			     Keep that list and the table in pg106_device_gate.c identical. -->
			<key>IOPCIPrimaryMatch</key>
			<string>0x000010de&amp;0x0000ffff</string>
			<key>IOPCIClassMatch</key>
			<string>0x03000000&amp;0xff000000</string>
			<key>IOProbeScore</key>
			<integer>1000</integer>
			<!-- Owner decision (pascal/kext/README.md "Who may open the render
			     client"): true lets non-administrator processes open render
			     connections (type 1). Boot-arg pg106_render_users overrides. -->
			<key>PG106RenderUsers</key>
			<false/>
		</dict>
