#version 450
// SPDX-License-Identifier: MIT
// pg106_vk_smoke compute check: out[i] = i * 3 + 7 (+ push constant bias).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Out { uint v[]; } o;
layout(push_constant) uniform Pc { uint n; uint bias; } pc;
void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i < pc.n)
      o.v[i] = i * 3u + 7u + pc.bias;
}
